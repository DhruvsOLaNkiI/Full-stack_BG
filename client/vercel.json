{
    "rewrites": [
        {
            "source": "/sitemap.xml",
            "destination": "https://YOUR-BACKEND-URL.onrender.com/sitemap.xml"
        },
        {
            "source": "/api/:match*",
            "destination": "https://YOUR-BACKEND-URL.onrender.com/api/:match*"
        },
        {
            "source": "/(.*)",
            "destination": "/index.html"
        }
    ]
}