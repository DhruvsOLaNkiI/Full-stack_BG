# Port for the server (Render/Railway sets this automatically)
PORT=5001

# Firebase Service Account Key (JSON content as a single line string)
# Required for Firebase Admin SDK authentication
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key_id":"...","private_key":"...","client_email":"...","client_id":"...","auth_uri":"...","token_uri":"...","auth_provider_x509_cert_url":"...","client_x509_cert_url":"..."}

# Client URL for CORS (Optional, defaults to allowing all or specific origins)
# CLIENT_URL=https://your-frontend-app.vercel.app
